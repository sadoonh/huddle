# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=local
AUTO_INIT_DB=false

# --- Database --------------------------------------------------------------
# SQLite is fine for local development; use PostgreSQL in deployed environments.
DATABASE_URL=sqlite:///./standup.db
# DATABASE_URL=postgresql+psycopg://standup:standup@localhost:5432/standup

# --- Authentication --------------------------------------------------------
# dev: X-Dev-User header / identity switcher. Never deploy with auth_mode=dev.
# nex: trust the SSO headers injected by the nex portal gateway.
AUTH_MODE=dev
DEV_DEFAULT_USER_EMAIL=manager@nex.local

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- AI transcript reconciliation -----------------------------------------
AI_PROVIDER=mock            # mock | bedrock
AI_PROCESSING_INLINE=true   # false -> queue/worker path
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Empty bucket -> local filesystem storage under TRANSCRIPT_LOCAL_DIR.
TRANSCRIPT_BUCKET=
TRANSCRIPT_LOCAL_DIR=.transcripts
# Set by Terraform; uploads are queued when AI_PROCESSING_INLINE=false.
SQS_QUEUE_URL=
